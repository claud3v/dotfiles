# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}

# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
function tre() {
	tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
}

# Determine size of a file or total size of a directory
function sizeOf() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

# Split a video into 2 parts of 2 hours each
split_video_2_hours() {
    local infile="$1"

    if [ ! -f "$infile" ]; then
        echo "Error: file not found: $infile"
        return 1
    fi

    local base="${infile%.*}"

    ffmpeg -i "$infile" -c copy -t 02:00:00 "${base}-part1.mp4"
    ffmpeg -i "$infile" -c copy -ss 02:00:00 "${base}-part2.mp4"
}

# Get the language of the tracks in a MKV file
# Use -e to get only the English tracks
# Example: mkvlang -e myvideo.mkv
mkvlang() {
  local eng_only=false
  local file

  if [ "$1" = "-e" ]; then
    eng_only=true
    shift
  fi

  file="$1"

  if [ -z "$file" ]; then
    echo "Usage: mkvlang [-e] <file.mkv>"
    return 1
  fi

  if $eng_only; then
    mkvmerge -J "$file" | jq '
      .tracks[]
      | select(.properties.language == "eng" or .properties.language == "und")
      | {id, language: .properties.language, type}
    '
  else
    mkvmerge -J "$file" | jq '
      .tracks[]
      | {id, language: .properties.language, type}
    '
  fi
}

# Extract the English audio and subtitle tracks from a MKV file
# Parameter:
# 1. The input MKV file
# 2. The audio track ID
# 3. The subtitle track ID
# Example: mkveng myvideo.mkv 1 2
mkveng() {
  local infile="$1"
  local audio_id="$2"
  local sub_id="$3"

  if [ -z "$infile" ] || [ -z "$audio_id" ] || [ -z "$sub_id" ]; then
    echo "Usage: mkveng <file.mkv> <audio_track_id> <subtitle_track_id>"
    return 1
  fi

  if [ ! -f "$infile" ]; then
    echo "File not found: $infile"
    return 1
  fi

  local outfile="${infile%.mkv}[ENG].mkv"

  mkvmerge -o "$outfile" \
    --audio-tracks "$audio_id" \
    --subtitle-tracks "$sub_id" \
    --default-track "${audio_id}:true"  --forced-track "${audio_id}:false" \
    --default-track "${sub_id}:true"    --forced-track "${sub_id}:false" \
    --language "${audio_id}:eng" \
    --language "${sub_id}:eng" \
    --track-name "${audio_id}:English" \
    --track-name "${sub_id}:English" \
    "$infile"
}

# Create an MKV from an MP4 + an English SRT subtitle file.
# Parameters:
# 1. Input MP4 file path
# 2. Input SRT file path
# Output:
# - Same base name as the MP4, but `.mkv` extension.
mkv_up() {
  local mp4="$1"
  local srt="$2"

  if [[ -z "$mp4" || -z "$srt" ]]; then
    echo "Usage: mkv_up /path/to/file.mp4 /path/to/file.en.srt"
    return 1
  fi

  if [[ ! -f "$mp4" ]]; then
    echo "Error: MP4 not found: '$mp4'"
    return 1
  fi

  if [[ ! -f "$srt" ]]; then
    echo "Error: SRT not found: '$srt'"
    return 1
  fi

  local outfile="${mp4%.mp4}.mkv"
  if [[ -e "$outfile" ]]; then
    echo "Error: output already exists: '$outfile'"
    return 1
  fi

  mkvmerge -o "$outfile" \
    --language 0:und \
    "$mp4" \
    --language 0:eng --track-name 0:'English' \
    "$srt"
}

# Set the title of a MKV file
# Parameter:
# 1. The input MKV file
# 2. The title
# Example: mkvtitle myvideo.mkv "Movie Title (Year)"
mkvtitle() {
  local file="$1"
  local title="$2"

  if [ -z "$file" ] || [ -z "$title" ]; then
    echo "Usage: mkvtitle <file.mkv> \"Movie Title (Year)\""
    return 1
  fi

  if [ ! -f "$file" ]; then
    echo "File not found: $file"
    return 1
  fi

  mkvpropedit "$file" \
    --edit info \
    --set "title=$title"
}

# Set the title of a MP4 file
# Parameter:
# 1. The input MP4 file
# 2. The title
# Example: fftitle myvideo.mp4 "Movie Title (Year)"
fftitle() {
  local infile="$1"
  local title="$2"

  if [ -z "$infile" ] || [ -z "$title" ]; then
    echo "Usage: fftitle <file.mp4> \"Title String\""
    return 1
  fi

  if [ ! -f "$infile" ]; then
    echo "File not found: $infile"
    return 1
  fi

  local tmpfile="${infile%.mp4}.tmp.mp4"

  ffmpeg -i "$infile" \
    -c copy \
    -metadata "title=$title" \
    "$tmpfile" \
  && mv -f "$tmpfile" "$infile"
}

# Select full English dialogue tracks from mkvmerge JSON on stdin.
# Keep this separate so the selection policy can be tested without remuxing.
_mkveng_select_tracks() {
  jq -c '
    def named($pattern): (.properties.track_name // "" | test($pattern; "i"));
    def english:
      .properties.language == "eng" or
      (.properties.language_ietf // "" | test("^en(-|$)"; "i"));
    def commentary:
      .properties.flag_commentary == true or named("commentary");
    def partial:
      .properties.forced_track == true or
      named("\\b(forced|signs?|songs?)\\b");
    def sdh:
      .properties.flag_hearing_impaired == true or
      named("\\b(SDH|CC)\\b|hearing[ -]impaired|closed[ -]captions?");
    def text_subtitle:
      (.properties.codec_id // "" | startswith("S_TEXT/")) or
      (.codec // "" | test("^(SubRip/SRT|SubStationAlpha|WebVTT)$"));
    def cues: (.properties.tag_number_of_frames // "0" | tonumber? // 0);
    def span:
      try (.properties.tag_duration | split(":") | map(tonumber) |
        .[0] * 3600 + .[1] * 60 + .[2]) catch 0;
    . as $source |
    [.tracks[] | select(.type == "audio" and english and (commentary | not))
      | select((.properties.flag_visual_impaired // false) == false)
      | select(named("audio description|descriptive audio") | not)] as $audio |
    [.tracks[] | select(.type == "subtitles" and english and (commentary | not))] as $english |
    [$english[] | select(partial | not)] as $full |
    ([$english[] | cues] | max // 0) as $max_cues |
    (($source.container.properties.duration // 0) / 1000000000) as $duration |
    # Counts and time spans are only suspicion checks, not a quality ranking.
    # A tiny track relative to another English track, or a sparse short span
    # in a long video, needs manual selection. Missing statistics are unknown.
    [$full[] | select(
      ((cues > 0 and $max_cues >= 100 and cues < $max_cues * 0.25) or
       (cues > 0 and cues < 100 and span > 0 and $duration >= 1200 and
        span < $duration * 0.2)) | not)] as $safe |
    [$safe[] | select(sdh | not)] as $ordinary |
    (if ($ordinary | length) > 0 then $ordinary else $safe end) as $dialogue |
    # Prefer text over image subtitles after excluding partial/sparse tracks
    # and applying the ordinary-dialogue preference. Do not rank by cue count:
    # image formats and SDH can contain more entries without better dialogue.
    [$dialogue[] | select(text_subtitle)] as $text |
    (if ($text | length) > 0 then $text else $dialogue end) as $preferred |
    if ($audio | length) == 0 then {error: "no identified English main audio"}
    elif ($full | length) == 0 then {error: "no identified full English subtitle track"}
    elif ($safe | length) == 0 then {error: "English subtitles look sparse; inspect with mkvlang/mkveng"}
    elif ($preferred | length) != 1 then {error: "multiple full English subtitle candidates; select manually with mkveng"}
    else {
      audio: ($audio | sort_by(if .properties.default_track then 0 else 1 end, .id) | first),
      subtitle: $preferred[0],
      reason: ((if ($preferred[0] | sdh) then "full English SDH/CC fallback"
                else "full English dialogue" end) +
               (if ($text | length) > 0 and ($dialogue | length) > ($text | length)
                then "; preferred text over image subtitles" else "" end)),
      subtitle_name: (if ($preferred[0] | sdh) then "English (SDH)" else "English" end)
    } end
  '
}

# Recursively remux English main audio and full dialogue subtitles.
# Prefer ordinary dialogue over SDH, then text over image subtitles.
# Preview choices without writing media: mkvengdir --dry-run /path/to/movies
# Ambiguous/unknown-language tracks require explicit IDs via mkveng.
mkvengdir() {
  local dry_run=false
  if [[ "$1" == "--dry-run" ]]; then
    dry_run=true
    shift
  fi
  local dir="$1"
  if [[ $# != 1 || ! -d "$dir" ]]; then
    echo "Usage: mkvengdir [--dry-run] <directory>"
    return 1
  fi
  local dependency
  for dependency in mkvmerge jq; do
    command -v "$dependency" >/dev/null || {
      echo "Missing dependency: $dependency"
      return 1
    }
  done
  # Absolute paths also handle a directory argument beginning with a dash.
  dir="${dir:A}"
  local f outfile json selection problem audio_id sub_id sub_name original_name
  local temp_dir temp_file output_json mux_rc
  local failures=0
  while IFS= read -r -d '' f; do
    outfile="${f%.mkv}[ENG].mkv"
    if [[ -e "$outfile" || -L "$outfile" ]]; then
      printf 'Skipping existing output: %s\n' "$outfile"
      continue
    fi
    printf 'Processing: %s\n' "$f"
    if ! json=$(mkvmerge -J "$f") || ! selection=$(printf '%s' "$json" | _mkveng_select_tracks); then
      echo "  Skipping: could not inspect tracks"
      failures=$((failures + 1))
      continue
    fi
    problem=$(printf '%s' "$selection" | jq -r '.error // empty')
    if [[ -n "$problem" ]]; then
      printf '  Skipping: %s\n' "$problem"
      failures=$((failures + 1))
      continue
    fi
    audio_id=$(printf '%s' "$selection" | jq -r '.audio.id')
    sub_id=$(printf '%s' "$selection" | jq -r '.subtitle.id')
    sub_name=$(printf '%s' "$selection" | jq -r '.subtitle_name')
    original_name=$(printf '%s' "$selection" | jq -r '.subtitle.properties.track_name // "(unnamed)"')
    printf '  Audio track ID: %s\n  Subtitle track ID: %s (%s)\n' "$audio_id" "$sub_id" "$original_name"
    printf '  Reason: %s\n  Output: %s\n' "$(printf '%s' "$selection" | jq -r '.reason')" "$outfile"
    [[ "$dry_run" == true ]] && continue

    # Publish only a complete, checked file. A hard link on the same filesystem
    # refuses an existing destination, including one created during the remux.
    temp_dir=$(mktemp -d "${f:h}/.mkveng.XXXXXX") || return 1
    temp_file="$temp_dir/output.mkv"
    mkvmerge -o "$temp_file" \
      --audio-tracks "$audio_id" --subtitle-tracks "$sub_id" \
      --default-track "${audio_id}:true" --forced-track "${audio_id}:false" \
      --default-track "${sub_id}:true" --forced-track "${sub_id}:false" \
      --language "${audio_id}:eng" --language "${sub_id}:eng" \
      --track-name "${audio_id}:English" --track-name "${sub_id}:${sub_name}" \
      "$f"
    mux_rc=$?
    # mkvmerge exit 1 means warnings; still inspect the resulting container.
    if (( mux_rc > 1 )) || ! output_json=$(mkvmerge -J "$temp_file") ||
       ! printf '%s' "$output_json" | jq -e --argjson selected "$selection" '
         [.tracks[] | select(.type == "audio")] as $audio |
         [.tracks[] | select(.type == "subtitles")] as $subs |
         ($audio | length) == 1 and ($subs | length) == 1 and
         $audio[0].properties.language == "eng" and
         $subs[0].properties.language == "eng" and
         $subs[0].properties.default_track == true and
         $subs[0].properties.forced_track == false and
         $subs[0].properties.track_name == $selected.subtitle_name and
         $subs[0].codec == $selected.subtitle.codec and
         (($selected.subtitle.properties.tag_number_of_frames // null) == null or
          $subs[0].properties.tag_number_of_frames == $selected.subtitle.properties.tag_number_of_frames)
       ' >/dev/null; then
      printf '  Failed remux or verification; inspect temporary output: %s\n' "$temp_dir"
      failures=$((failures + 1))
      continue
    fi
    if ln "$temp_file" "$outfile"; then
      rm -- "$temp_file"
      rmdir -- "$temp_dir"
      printf '  Verified: %s\n' "$outfile"
    else
      printf '  Could not publish output; retained: %s\n' "$temp_file"
      failures=$((failures + 1))
    fi
  done < <(find "$dir" -type d -name '.mkveng.*' -prune -o \
    -type f -name '*.mkv' ! -name '*[[]ENG[]]*' -print0)
  if (( failures > 0 )); then
    printf 'Could not process %d file(s); see reasons above.\n' "$failures"
    return 1
  fi
}

# Clean up MKV files in a directory: for each literal [ENG] file, remove its
# untagged counterpart if present, then remove the tag from the retained file.
# Parameter:
# 1. The input directory
# Example: cleanNonEngMkvs /path/to/movies
cleanNonEngMkvs() {
  local target_dir="$1"
  local file destination reply
  local -a eng_files non_eng_files destinations

  if [[ -z "$target_dir" ]]; then
    echo "Usage: cleanNonEngMkvs /path/to/directory"
    return 1
  fi

  if [[ ! -d "$target_dir" ]]; then
    echo "Error: '$target_dir' is not a directory"
    return 1
  fi

  # [ENG] must be expressed as literal brackets in a find glob. Plain [ENG]
  # means "one E, N, or G character" and does not match the literal tag.
  while IFS= read -r -d '' file; do
    eng_files+=("$file")
    destinations+=("${file//\[ENG\]/}")
  done < <(find "$target_dir" -type f -name '*[[]ENG[]]*.mkv' -print0)

  # Only an exact untagged counterpart of an [ENG] file may be deleted.
  # Other untagged episodes must be left alone.
  for destination in "${destinations[@]}"; do
    if [[ -f "$destination" && ! -L "$destination" ]]; then
      non_eng_files+=("$destination")
    fi
  done

  # A completed run strips the tags. Refusing an untagged-only directory makes
  # the function safe to run again instead of deleting its previous outputs.
  if (( ${#eng_files[@]} == 0 )); then
    echo "Refusing to make changes: no MKV filename containing literal [ENG] was found."
    echo "This may already be a directory previously processed by cleanNonEngMkvs."
    return 1
  fi

  # Abort before deleting anything if two tagged inputs would become the same
  # destination, or if a destination exists outside the deletion plan.
  local i j destination_is_deleted
  for (( i = 1; i <= ${#destinations[@]}; i++ )); do
    for (( j = i + 1; j <= ${#destinations[@]}; j++ )); do
      if [[ "${destinations[$i]}" == "${destinations[$j]}" ]]; then
        echo "Refusing to make changes: multiple [ENG] files map to '${destinations[$i]}'."
        return 1
      fi
    done

    destination="${destinations[$i]}"
    if [[ -e "$destination" || -L "$destination" ]]; then
      destination_is_deleted=false
      for file in "${non_eng_files[@]}"; do
        if [[ "$file" == "$destination" ]]; then
          destination_is_deleted=true
          break
        fi
      done

      if [[ "$destination_is_deleted" != true ]]; then
        echo "Refusing to make changes: rename destination already exists: '$destination'"
        return 1
      fi
    fi
  done

  echo "Planned MKV cleanup in '$target_dir':"
  for (( i = 1; i <= ${#eng_files[@]}; i++ )); do
    echo "  KEEP:   '${eng_files[$i]}'"
    echo "  RENAME: '${destinations[$i]}'"
  done
  for file in "${non_eng_files[@]}"; do
    echo "  DELETE: '$file'"
  done
  echo
  printf "Delete %d untagged MKV(s) and rename %d tagged MKV(s)? [y/N] " \
    "${#non_eng_files[@]}" "${#eng_files[@]}"
  IFS= read -r reply

  if [[ "$reply" != [yY] && "$reply" != [yY][eE][sS] ]]; then
    echo "No changes made."
    return 0
  fi

  if (( ${#non_eng_files[@]} > 0 )); then
    rm -f -- "${non_eng_files[@]}" || {
      echo "Error: failed to delete one or more untagged MKVs; no renames attempted."
      return 1
    }
  fi

  for (( i = 1; i <= ${#eng_files[@]}; i++ )); do
    mv -- "${eng_files[$i]}" "${destinations[$i]}" || return 1
  done
}

# Clean up MP4 files in a directory - removes filenames containing literal [UPDATED]
# Parameter:
# 1. The input directory
# Example: cleanUpdatedMp4s /path/to/movies
cleanUpdatedMp4s() {
  local target_dir="$1"

  if [[ -z "$target_dir" ]]; then
    echo "Usage: cleanUpdatedMp4s /path/to/directory"
    return 1
  fi

  if [[ ! -d "$target_dir" ]]; then
    echo "Error: '$target_dir' is not a directory"
    return 1
  fi

  # For each `*[UPDATED]*.mp4`, delete the corresponding original (with `[UPDATED]`
  # removed) and rename the updated file to the original name.
  find "$target_dir" -type f -name '*[[]UPDATED[]]*.mp4' -print0 | while IFS= read -r -d '' file; do
    local newfile="${file//\[UPDATED\]/}"

    if [[ -z "$newfile" || "$newfile" == "$file" ]]; then
      continue
    fi

    # Delete old/original if present.
    if [[ -e "$newfile" ]]; then
      rm -f "$newfile"
    fi

    mv -f "$file" "$newfile"
  done
}

# Shift the subtitle file by the given offset in seconds
# Parameter:
# 1. The subtitle file
# 2. The offset in seconds
# Example: shiftSubtitle myvideo.srt 10
shiftSubtitle() {
    local subfile="$1"
    local offset="$2"

    if [[ -z "$subfile" || -z "$offset" ]]; then
        echo "Usage: shift_subtitle /path/to/file.srt OFFSET_IN_SECONDS"
        return 1
    fi

    if [[ ! -f "$subfile" ]]; then
        echo "Error: '$subfile' does not exist"
        return 1
    fi

    # Use a template for macOS compatibility
    local tmpfile="$(mktemp /tmp/subshift.XXXXXX.srt)"

    ffmpeg -y -itsoffset "$offset" -i "$subfile" -c copy "$tmpfile" >/dev/null 2>&1

    if [[ $? -eq 0 ]]; then
        mv "$tmpfile" "$subfile"
        echo "Shifted '$subfile' by $offset seconds."
    else
        echo "Error shifting '$subfile'"
        rm -f "$tmpfile"
        return 1
    fi
}

# Copy an MP4 and update its metadata title, appending [UPDATED] to filename.
# Parameters:
# 1. Input MP4 file path
# 2. Title string
# Example: fftitle_updated "Zoolander (2001) - [1080p].mp4" "Zoolander (2001)"
fftitle_update() {
    local infile="$1"
    local title="$2"

    if [[ -z "$infile" || -z "$title" ]]; then
        echo "Usage: fftitle_updated /path/to/file.mp4 \"Title String\""
        return 1
    fi

    if [[ ! -f "$infile" ]]; then
        echo "File not found: '$infile'"
        return 1
    fi

    if [[ "${infile##*.}" != "mp4" ]]; then
        echo "Error: input must be an .mp4 file: '$infile'"
        return 1
    fi

    local outfile="${infile%.mp4}[UPDATED].mp4"
    if [[ -e "$outfile" ]]; then
        echo "Error: output already exists: '$outfile'"
        return 1
    fi

    ffmpeg -i "$infile" -c copy -metadata "title=$title" "$outfile"
}

# Reduce a PNG with pngquant + oxipng.
# Parameter:
# 1. Input PNG file path
# Output:
# - Same directory as input, but suffixed with `-reduced.png`
# Example: pngreduce input.png  # -> input-reduced.png
pngreduce() {
  local infile="$1"

  if [[ -z "$infile" ]]; then
    echo "Usage: pngreduce /path/to/input.png"
    return 1
  fi

  if [[ ! -f "$infile" ]]; then
    echo "File not found: '$infile'"
    return 1
  fi

  if [[ "${infile##*.}" != "png" ]]; then
    echo "Error: input must be a .png file: '$infile'"
    return 1
  fi

  local outfile="${infile%.png}-reduced.png"

  pngquant --quality=65-85 --force --output "$outfile" -- "$infile" \
    && oxipng -o max -- "$outfile"
}
